{
  "name": "dsh-fishchat",
  "version": "1.0.1",
  "type": "module",
  "description": "Group chat for DeepSeek Harness: one sidebar row, a WeChat-style main panel where you and several agent sessions talk in the same room.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/7ygys/dsh-fishchat.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "group-chat",
    "rooms"
  ],
  "license": "MIT",
  "homepage": "https://github.com/7ygys/dsh-fishchat",
  "bugs": {
    "url": "https://github.com/7ygys/dsh-fishchat/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
