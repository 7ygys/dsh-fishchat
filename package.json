{
  "name": "dsh-fishchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Group chat for DSH: one sidebar row, a WeChat-style main panel shared by the user and several agent sessions.",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/7ygys/dsh-fishchat.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "group-chat",
    "rooms"
  ]
}
